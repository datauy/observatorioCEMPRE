<table id="prices">
  <tr class="theaders">
    <th><i class="fa fa-flag"></i>País</th>
    <% @materials.each do |m| %>
    <th><i class="fa fa-recycle"></i><%= m.name %></th>
    <% end %>
  </tr>
  <% @countries.each do |c| %>
  <tr>
    <td class="name"><%= c.name %></td>
    <% @materials.each do |m| %>
    <td>
      <% price = Price.where(buyer_id: c.id, material_id: m.id ).first %>
      <% if price.present? %>
        <%= format_price(price) %>
      <% end %>
    </td>
    <% end %>
  </tr>
    <% buyers = Buyer.includes(:prices).where(buyer_id: c.id).where.not('prices.id': nil).each do |b| %>
    <tr>
      <td class="name"><%= link_to b.name, buyer_path(b.id), target: '_blank' %></td>
      <% @materials.each do |m| %>
      <td>
        <% price = Price.where(buyer_id: b.id, material_id: m.id ).first %>
        <% if price.present? %>
          <%= format_price(price) %>
        <% end %>
      </td>
      <% end %>
    </tr>
    <% end %>
  <% end %>
</table>
<script>
function loadTooltip(e) {
  let tooltip = e.target.closest('.price-action').querySelector('.tooltip')
  let activate = false
  if ( !tooltip.classList.contains('active') ) {
    activate = true
  }
  document.querySelectorAll('.tooltip').forEach((tt) => {
    tt.classList.remove('active')
  })
  if ( activate ) {
    tooltip.classList.add('active')
  }
}
</script>